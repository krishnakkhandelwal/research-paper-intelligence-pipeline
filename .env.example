# LLM provider config (Phase 2 enrichment).
# Leave OPENAI_API_KEY empty to run with the built-in heuristic extractor (no API cost).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_CONTEXT_CHARS=12000
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage
DB_PATH=./data/papers.db
FAISS_INDEX_PATH=./data/faiss_index.bin

# Embedding / chunking (sizes are in WORDS; see config/settings.py)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=150
CHUNK_OVERLAP=30
TOP_K=5
